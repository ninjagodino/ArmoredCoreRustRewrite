@@ -174,6 +175,11 @@ bool PPCHIRBuilder::Emit(GuestFunction* function, uint32_t flags) {
 
     MaybeBreakOnInstruction(address);
 
+    if (Function* probe = LookupAcvdProbe(address)) {
+      ContextBarrier();
+      CallExtern(probe);
+    }
+
     InstrData i;
     i.address = address;
     i.code = code;
