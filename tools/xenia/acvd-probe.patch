+/**
+ ******************************************************************************
+ * ACVD rewrite: guest-address probes that log register and memory values.     *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_CPU_PPC_ACVD_PROBE_H_
+#define XENIA_CPU_PPC_ACVD_PROBE_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace cpu {
+class Function;
+class Processor;
+namespace ppc {
+
+// Reads --acvd_probes and defines one builtin per probe address. Call once
+// from the frontend before any guest code is translated.
+void InitializeAcvdProbes(Processor* processor);
+
+// The builtin to call before the guest instruction at `address`, or nullptr.
+Function* LookupAcvdProbe(uint32_t address);
+
+}  // namespace ppc
+}  // namespace cpu
+}  // namespace xe
+
+#endif  // XENIA_CPU_PPC_ACVD_PROBE_H_
