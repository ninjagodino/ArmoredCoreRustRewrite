+/**
+ ******************************************************************************
+ * ACVD rewrite: a scripted controller, driven by a command file.             *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_HID_ACVD_SCRIPT_DRIVER_H_
+#define XENIA_HID_ACVD_SCRIPT_DRIVER_H_
+
+#include <filesystem>
+#include <functional>
+#include <memory>
+
+#include "xenia/hid/input_driver.h"
+
+namespace xe {
+namespace hid {
+
+// Saves the current guest frame as a PNG; set by the emulator window.
+extern std::function<bool(const std::filesystem::path&)> acvd_screenshot;
+
+// Null unless --acvd_input names a command file.
+std::unique_ptr<InputDriver> CreateAcvdScriptDriver(xe::ui::Window* window,
+                                                    size_t window_z_order);
+
+}  // namespace hid
+}  // namespace xe
+
+#endif  // XENIA_HID_ACVD_SCRIPT_DRIVER_H_
