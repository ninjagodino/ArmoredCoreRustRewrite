diff --git a/src/xenia/hid/acvd_script_driver.cc b/src/xenia/hid/acvd_script_driver.cc
new file mode 100644
index 000000000..13c8d100e
--- /dev/null
+++ b/src/xenia/hid/acvd_script_driver.cc
@@ -0,0 +1,271 @@
+/**
+ ******************************************************************************
+ * ACVD rewrite: a scripted controller, driven by a command file.             *
+ ******************************************************************************
+ *
+ * --acvd_input names a text file that a script appends commands to; it is
+ * polled every few milliseconds, so the emulator window needs no focus:
+ *
+ *   down A B ...      hold buttons (A B X Y LB RB START BACK LS RS UP DOWN
+ *   up A B ...        LEFT RIGHT GUIDE), or release them
+ *   stick L|R X Y     thumbstick, -1..1 per axis
+ *   trigger L|R V     trigger, 0..1
+ *   release           everything back to neutral
+ *   shot PATH         save the current guest frame as a PNG at PATH
+ *
+ * The controller sits on --acvd_input_port and stays connected while the cvar
+ * is set; it is queried before every other input driver.
+ */
+
+#include "xenia/hid/acvd_script_driver.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+
+#include "xenia/base/cvar.h"
+#include "xenia/base/filesystem.h"
+#include "xenia/base/logging.h"
+#include "xenia/ui/virtual_key.h"
+
+DEFINE_path(acvd_input, "",
+            "Command file for the ACVD scripted controller on port 0 (see "
+            "src/xenia/hid/acvd_script_driver.cc).",
+            "ACVD");
+DEFINE_uint32(acvd_input_port, 0,
+              "Controller port [0, 3] of the ACVD scripted controller; the "
+              "game wants a signed-in profile in that slot.",
+              "ACVD");
+
+namespace xe {
+namespace hid {
+
+std::function<bool(const std::filesystem::path&)> acvd_screenshot;
+
+namespace {
+
+struct Button {
+  const char* name;
+  uint16_t bit;
+  ui::VirtualKey key;
+};
+
+constexpr Button kButtons[] = {
+    {"UP", X_INPUT_GAMEPAD_DPAD_UP, ui::VirtualKey::kXInputPadDpadUp},
+    {"DOWN", X_INPUT_GAMEPAD_DPAD_DOWN, ui::VirtualKey::kXInputPadDpadDown},
+    {"LEFT", X_INPUT_GAMEPAD_DPAD_LEFT, ui::VirtualKey::kXInputPadDpadLeft},
+    {"RIGHT", X_INPUT_GAMEPAD_DPAD_RIGHT, ui::VirtualKey::kXInputPadDpadRight},
+    {"START", X_INPUT_GAMEPAD_START, ui::VirtualKey::kXInputPadStart},
+    {"BACK", X_INPUT_GAMEPAD_BACK, ui::VirtualKey::kXInputPadBack},
+    {"LS", X_INPUT_GAMEPAD_LEFT_THUMB, ui::VirtualKey::kXInputPadLThumbPress},
+    {"RS", X_INPUT_GAMEPAD_RIGHT_THUMB, ui::VirtualKey::kXInputPadRThumbPress},
+    {"LB", X_INPUT_GAMEPAD_LEFT_SHOULDER, ui::VirtualKey::kXInputPadLShoulder},
+    {"RB", X_INPUT_GAMEPAD_RIGHT_SHOULDER,
+     ui::VirtualKey::kXInputPadRShoulder},
+    {"GUIDE", X_INPUT_GAMEPAD_GUIDE, ui::VirtualKey::kXInputPadGuide},
+    {"A", X_INPUT_GAMEPAD_A, ui::VirtualKey::kXInputPadA},
+    {"B", X_INPUT_GAMEPAD_B, ui::VirtualKey::kXInputPadB},
+    {"X", X_INPUT_GAMEPAD_X, ui::VirtualKey::kXInputPadX},
+    {"Y", X_INPUT_GAMEPAD_Y, ui::VirtualKey::kXInputPadY},
+};
+
+int16_t Axis(double v) {
+  return static_cast<int16_t>(std::lround(std::clamp(v, -1.0, 1.0) * 32767));
+}
+
+class AcvdScriptDriver final : public InputDriver {
+ public:
+  AcvdScriptDriver(xe::ui::Window* window, size_t window_z_order,
+                   std::filesystem::path path)
+      : InputDriver(window, window_z_order), path_(std::move(path)) {}
+
+  ~AcvdScriptDriver() override {
+    stop_ = true;
+    if (thread_.joinable()) thread_.join();
+  }
+
+  X_STATUS Setup() override {
+    // Start from an empty file so stale commands never replay.
+    std::ofstream(path_, std::ios::trunc);
+    thread_ = std::thread([this] { Poll(); });
+    XELOGI("ACVD scripted controller reading {}", xe::path_to_utf8(path_));
+    return X_STATUS_SUCCESS;
+  }
+
+  X_RESULT GetCapabilities(uint32_t user_index, uint32_t flags,
+                           X_INPUT_CAPABILITIES* out_caps) override {
+    if (user_index != port_) return X_ERROR_DEVICE_NOT_CONNECTED;
+    if (out_caps) {
+      std::memset(out_caps, 0, sizeof(*out_caps));
+      out_caps->type = 0x01;      // gamepad
+      out_caps->sub_type = 0x01;  // standard controller
+      out_caps->gamepad.buttons = 0xF7FF;
+      out_caps->gamepad.left_trigger = 0xFF;
+      out_caps->gamepad.right_trigger = 0xFF;
+      out_caps->gamepad.thumb_lx = INT16_MAX;
+      out_caps->gamepad.thumb_ly = INT16_MAX;
+      out_caps->gamepad.thumb_rx = INT16_MAX;
+      out_caps->gamepad.thumb_ry = INT16_MAX;
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT GetState(uint32_t user_index, X_INPUT_STATE* out_state) override {
+    if (user_index != port_) return X_ERROR_DEVICE_NOT_CONNECTED;
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (out_state) {
+      out_state->packet_number = packet_;
+      out_state->gamepad.buttons = buttons_;
+      out_state->gamepad.left_trigger = left_trigger_;
+      out_state->gamepad.right_trigger = right_trigger_;
+      out_state->gamepad.thumb_lx = lx_;
+      out_state->gamepad.thumb_ly = ly_;
+      out_state->gamepad.thumb_rx = rx_;
+      out_state->gamepad.thumb_ry = ry_;
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT SetState(uint32_t user_index,
+                    X_INPUT_VIBRATION* vibration) override {
+    return user_index == port_ ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+  X_RESULT GetKeystroke(uint32_t user_index, uint32_t flags,
+                        X_INPUT_KEYSTROKE* out_keystroke) override {
+    if (user_index != port_ && user_index != XUserIndexAny) {
+      return X_ERROR_DEVICE_NOT_CONNECTED;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (keystrokes_.empty()) return X_ERROR_EMPTY;
+    if (out_keystroke) *out_keystroke = keystrokes_.front();
+    keystrokes_.pop_front();
+    return X_ERROR_SUCCESS;
+  }
+
+  InputType GetInputType() const override { return InputType::Controller; }
+
+ private:
+  void SetButtons(uint16_t buttons) {
+    for (auto& b : kButtons) {
+      bool was = buttons_ & b.bit, now = buttons & b.bit;
+      if (was == now) continue;
+      X_INPUT_KEYSTROKE k = {};
+      k.virtual_key = static_cast<uint16_t>(b.key);
+      k.flags = now ? X_INPUT_KEYSTROKE_KEYDOWN : X_INPUT_KEYSTROKE_KEYUP;
+      k.user_index = static_cast<uint8_t>(port_);
+      keystrokes_.push_back(k);
+    }
+    buttons_ = buttons;
+  }
+
+  void Execute(const std::string& line) {
+    std::istringstream words(line);
+    std::string verb;
+    if (!(words >> verb) || verb[0] == '#') return;
+    if (verb == "shot") {
+      std::string rest;
+      std::getline(words, rest);
+      rest.erase(0, rest.find_first_not_of(" \t"));
+      bool ok = acvd_screenshot && acvd_screenshot(rest);
+      if (!ok) XELOGE("ACVD scripted controller: shot {} failed", rest);
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (verb == "down" || verb == "up") {
+      uint16_t buttons = buttons_;
+      std::string name;
+      while (words >> name) {
+        std::transform(name.begin(), name.end(), name.begin(), ::toupper);
+        auto it = std::find_if(std::begin(kButtons), std::end(kButtons),
+                               [&](auto& b) { return name == b.name; });
+        if (it == std::end(kButtons)) {
+          XELOGE("ACVD scripted controller: unknown button {}", name);
+          continue;
+        }
+        buttons = verb == "down" ? (buttons | it->bit) : (buttons & ~it->bit);
+      }
+      SetButtons(buttons);
+    } else if (verb == "stick") {
+      std::string side;
+      double x = 0, y = 0;
+      words >> side >> x >> y;
+      bool left = side == "L" || side == "l";
+      (left ? lx_ : rx_) = Axis(x);
+      (left ? ly_ : ry_) = Axis(y);
+    } else if (verb == "trigger") {
+      std::string side;
+      double v = 0;
+      words >> side >> v;
+      auto value = static_cast<uint8_t>(std::lround(std::clamp(v, 0.0, 1.0) * 255));
+      (side == "L" || side == "l" ? left_trigger_ : right_trigger_) = value;
+    } else if (verb == "release") {
+      SetButtons(0);
+      left_trigger_ = right_trigger_ = 0;
+      lx_ = ly_ = rx_ = ry_ = 0;
+    } else {
+      XELOGE("ACVD scripted controller: unknown command '{}'", line);
+      return;
+    }
+    ++packet_;
+  }
+
+  void Poll() {
+    std::streamoff offset = 0;
+    std::string pending;
+    while (!stop_) {
+      std::ifstream file(path_, std::ios::binary);
+      if (file) {
+        file.seekg(0, std::ios::end);
+        std::streamoff size = file.tellg();
+        if (size < offset) offset = 0;
+        if (size > offset) {
+          file.seekg(offset);
+          std::string chunk(static_cast<size_t>(size - offset), '\0');
+          file.read(chunk.data(), chunk.size());
+          offset = size;
+          pending += chunk;
+          size_t newline;
+          while ((newline = pending.find('\n')) != std::string::npos) {
+            std::string line = pending.substr(0, newline);
+            pending.erase(0, newline + 1);
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            Execute(line);
+          }
+        }
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+  }
+
+  std::filesystem::path path_;
+  uint32_t port_ = std::min<uint32_t>(cvars::acvd_input_port, 3);
+  std::thread thread_;
+  std::atomic<bool> stop_{false};
+  std::mutex mutex_;
+  uint32_t packet_ = 1;
+  uint16_t buttons_ = 0;
+  uint8_t left_trigger_ = 0, right_trigger_ = 0;
+  int16_t lx_ = 0, ly_ = 0, rx_ = 0, ry_ = 0;
+  std::deque<X_INPUT_KEYSTROKE> keystrokes_;
+};
+
+}  // namespace
+
+std::unique_ptr<InputDriver> CreateAcvdScriptDriver(xe::ui::Window* window,
+                                                    size_t window_z_order) {
+  if (cvars::acvd_input.empty()) return nullptr;
+  return std::make_unique<AcvdScriptDriver>(window, window_z_order,
+                                            cvars::acvd_input);
+}
+
+}  // namespace hid
+}  // namespace xe
